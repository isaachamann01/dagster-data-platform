# --- Imports -----------------------------------------------------------------
# Comma-separated package prefixes that dotted import references
# (contract callables, transformations) are allowed to resolve from.
# The active project's own src/ packages are trusted automatically.
DATA_PLATFORM_TRUSTED_PREFIXES=

# --- REST source -------------------------------------------------------------
DATA_PLATFORM_REST_BASE_URL=http://localhost:8000
DATA_PLATFORM_REST_TIMEOUT_SECONDS=10
DATA_PLATFORM_REST_MAX_RETRIES=3
DATA_PLATFORM_REST_BACKOFF_SECONDS=0.5
# Optional static headers, as a JSON object string
DATA_PLATFORM_REST_HEADERS={}
# Optional API key sent as a header by the REST resource
DATA_PLATFORM_REST_API_KEY=
DATA_PLATFORM_REST_API_KEY_HEADER=X-API-Key
DATA_PLATFORM_REST_VERIFY_SSL=true

# --- Spark -------------------------------------------------------------------
# local | remote
DATA_PLATFORM_SPARK_MODE=local
DATA_PLATFORM_SPARK_MASTER=local[2]
# Spark Connect / remote master URL, required when mode=remote
DATA_PLATFORM_SPARK_REMOTE_URL=
DATA_PLATFORM_SPARK_APP_NAME=data-platform
DATA_PLATFORM_SPARK_WAREHOUSE_DIR=/tmp/dagster_pipelines/warehouse
# Extra Maven coordinates, e.g. org.apache.hadoop:hadoop-aws:3.4.1
DATA_PLATFORM_SPARK_EXTRA_PACKAGES=

# --- Lakehouse storage -------------------------------------------------------
# local | s3
DATA_PLATFORM_LAKEHOUSE_MODE=local
DATA_PLATFORM_LAKEHOUSE_LOCAL_ROOT=/tmp/dagster_pipelines/lakehouse
DATA_PLATFORM_S3_ENDPOINT_URL=http://localhost:9000
DATA_PLATFORM_S3_ACCESS_KEY_ID=minioadmin
DATA_PLATFORM_S3_SECRET_ACCESS_KEY=minioadmin
DATA_PLATFORM_S3_BUCKET=lakehouse
DATA_PLATFORM_S3_REGION=us-east-1
DATA_PLATFORM_S3_BASE_PREFIX=medallion
DATA_PLATFORM_S3_USE_SSL=false

# --- Trino (optional) --------------------------------------------------------
DATA_PLATFORM_TRINO_ENABLED=false
DATA_PLATFORM_TRINO_HOST=localhost
DATA_PLATFORM_TRINO_PORT=8080
DATA_PLATFORM_TRINO_USER=opencode
DATA_PLATFORM_TRINO_CATALOG=delta
DATA_PLATFORM_TRINO_SCHEMA=default
DATA_PLATFORM_TRINO_HTTP_SCHEME=http

# --- External metadata (optional, disabled when unset) -----------------------
DATA_PLATFORM_METADATA_ENDPOINT=
DATA_PLATFORM_METADATA_TIMEOUT_SECONDS=5
DATA_PLATFORM_METADATA_API_KEY=

# --- Synthetic data service --------------------------------------------------
SYNTHETIC_API_CONTRACTS_DIR=projects/example_pipelines/src/data_contracts/yaml
SYNTHETIC_API_HOST=0.0.0.0
SYNTHETIC_API_PORT=8000

# --- Docker Compose image overrides ------------------------------------------
# MinIO removed its official public images; Compose defaults to Bitnami legacy.
# Set these to your own mirror if needed.
MINIO_IMAGE=bitnamilegacy/minio:latest
MINIO_CLIENT_IMAGE=bitnamilegacy/minio-client:latest
